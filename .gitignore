# plan / notes (private, not part of the repo)
/plan.txt

# Go
/api/apanel
/api/*.db
/api/*.db-journal
/api/tmp/
/api/dev.env

# frontend
/web/node_modules/
/web/dist/
/web/.vite/

# docs (vitepress)
/docs/node_modules/
/docs/docs/.vitepress/dist/
/docs/docs/.vitepress/cache/

# real frontend build embedded into the Go binary (produced by
# `make build-web`); only the fallback placeholder index.html is tracked
/api/internal/httpserver/dist/*
!/api/internal/httpserver/dist/index.html

# local dev convenience script (build + reinstall over the running
# systemd service); not part of the repo
/deploy.sh

# local dev convenience script (build docs + sync into nginx's docroot);
# not part of the repo
/docs/deploy.sh

# misc
*.log
.DS_Store

# Claude Code session-local runtime state, not project config
/.claude/
