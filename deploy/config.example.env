# Copy to /etc/apanel/config.env (path fixed by apanel.service's
# EnvironmentFile=), chmod 600 it, and fill in APANEL_PASSWORD. apanel
# itself only ever reads these as plain environment variables — it has no
# idea this file exists. Everything but the password is optional.

APANEL_PASSWORD=change-me

APANEL_LISTEN_ADDR=:8080

# sqlite://<path>, postgres://user:pass@host:5432/dbname,
# or mysql://user:pass@tcp(host:3306)/dbname
# Defaults to sqlite://./apanel.db if omitted.
APANEL_DSN=sqlite:///var/lib/apanel/apanel.db

# apanel must be served over HTTPS. Either put a TLS-terminating reverse
# proxy in front of it (leave these unset), or have apanel terminate TLS
# itself by setting both of these to a certificate/key pair — e.g. from
# certbot: /etc/letsencrypt/live/<domain>/fullchain.pem and privkey.pem.
# Both must be set together, or neither.
#APANEL_TLS_CERT=/etc/apanel/tls/fullchain.pem
#APANEL_TLS_KEY=/etc/apanel/tls/privkey.pem
