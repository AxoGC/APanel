# Copy to /etc/apanel/config.env (or point APANEL_CONFIG at another path),
# chmod 600 it, and fill in APANEL_PASSWORD. Everything else is optional;
# apanel falls back to sane defaults.

APANEL_PASSWORD=change-me

APANEL_LISTEN_ADDR=:8080

# sqlite://<path>, postgres://user:pass@host:5432/dbname,
# or mysql://user:pass@tcp(host:3306)/dbname
# Defaults to sqlite://./apanel.db if omitted.
APANEL_DSN=sqlite:///var/lib/apanel/apanel.db
