# Used by `vite build --mode standalone` (invoked by the Tauri packaging
# step — see src-tauri/tauri.conf.json's beforeBuildCommand). Switches the
# app from the default integrated build (embedded in the Go binary, always
# relative /api/) to the standalone build (a Tauri desktop app that talks to
# a remote apanel instance entered at login) — see src/lib/apiBase.ts.
VITE_STANDALONE=true
